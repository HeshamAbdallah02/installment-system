generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// USERS & BRANCHES
// ============================================================================

model Branch {
  id         Int      @id @default(autoincrement())
  name       String   @db.VarChar(100)
  code       String   @unique @db.VarChar(20)
  address    String?  @db.Text
  city       String?  @db.VarChar(50)
  phone      String?  @db.VarChar(20)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  users      User[]
  orders     Order[]

  @@map("branches")
}

model User {
  id                Int               @id @default(autoincrement())
  username          String            @unique @db.VarChar(50)
  passwordHash      String            @db.VarChar(255)
  fullName          String            @db.VarChar(100)
  email             String?           @db.VarChar(100)
  role              String            @db.VarChar(20) // SELLER, MANAGER, ADMIN
  branchId          Int?
  isActive          Boolean           @default(true)
  lastLoginAt       DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  branch            Branch?           @relation(fields: [branchId], references: [id])
  customersCreated  Customer[]        @relation("CustomerCreatedBy")
  filesUploaded     FileStorage[]     @relation("FileUploadedBy")
  ordersCreated     Order[]           @relation("OrderCreatedBy")
  plansCreated      InstallmentPlan[] @relation("PlanCreatedBy")
  paymentsCollected Payment[]         @relation("PaymentCollectedBy")
  eventLogs         EventLog[]

  @@map("users")
}

// ============================================================================
// CUSTOMERS & FILES
// ============================================================================

model Customer {
  id               Int               @id @default(autoincrement())
  fullName         String            @db.VarChar(100)
  nationalId       String            @unique @db.Char(14)
  phone            String            @db.VarChar(20)
  phoneSecondary   String?           @db.VarChar(20)
  address          String?           @db.Text
  city             String?           @db.VarChar(50)
  createdBy        Int
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  createdByUser    User              @relation("CustomerCreatedBy", fields: [createdBy], references: [id])
  orders           Order[]
  installmentPlans InstallmentPlan[]
  payments         Payment[]

  @@map("customers")
}

model FileStorage {
  id            Int      @id @default(autoincrement())
  entityType    String   @db.VarChar(50) // CUSTOMER_ID, CONTRACT, PAYMENT_RECEIPT, OTHER
  entityId      Int
  storagePath   String   @db.VarChar(500)
  fileName      String   @db.VarChar(255)
  mimeType      String?  @db.VarChar(100)
  fileSizeBytes BigInt?
  fileHash      String   @db.VarChar(64)
  uploadedBy    Int
  uploadedAt    DateTime @default(now())
  uploadedByUser User    @relation("FileUploadedBy", fields: [uploadedBy], references: [id])

  @@index([entityType, entityId])
  @@map("file_storage")
}

// ============================================================================
// PRODUCTS & PRICING
// ============================================================================

model Product {
  id               Int         @id @default(autoincrement())
  code             String      @unique @db.VarChar(50)
  name             String      @db.VarChar(200)
  description      String?     @db.Text
  cashPrice        Decimal     @db.Decimal(12, 2)
  requiresDeposit  Boolean     @default(false)
  minDepositAmount Decimal?    @db.Decimal(12, 2)
  category         String?     @db.VarChar(50)
  isActive         Boolean     @default(true)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  orderItems       OrderItem[]

  @@map("products")
}

model InstallmentRatio {
  id              Int      @id @default(autoincrement())
  periodMonths    Int      @unique
  ratioMultiplier Decimal  @db.Decimal(5, 4)
  description     String?  @db.Text
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())

  @@map("installment_ratios")
}

// ============================================================================
// ORDERS & INSTALLMENT PLANS
// ============================================================================

model Order {
  id               Int               @id @default(autoincrement())
  orderNumber      String            @unique @db.VarChar(50)
  customerId       Int
  branchId         Int
  orderDate        DateTime          @default(now()) @db.Date
  totalAmount      Decimal           @db.Decimal(12, 2)
  paymentType      String            @db.VarChar(20) // CASH, INSTALLMENT
  status           String            @default("PENDING") @db.VarChar(20) // PENDING, CONFIRMED, COMPLETED, CANCELLED
  createdBy        Int
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  customer         Customer          @relation(fields: [customerId], references: [id])
  branch           Branch            @relation(fields: [branchId], references: [id])
  createdByUser    User              @relation("OrderCreatedBy", fields: [createdBy], references: [id])
  orderItems       OrderItem[]
  installmentPlan  InstallmentPlan?
  payments         Payment[]

  @@index([customerId])
  @@index([orderDate])
  @@index([status])
  @@map("orders")
}

model OrderItem {
  id        Int     @id @default(autoincrement())
  orderId   Int
  productId Int
  quantity  Int
  unitPrice Decimal @db.Decimal(12, 2)
  lineTotal Decimal @db.Decimal(12, 2)
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@map("order_items")
}

model InstallmentPlan {
  id              Int                  @id @default(autoincrement())
  orderId         Int                  @unique
  customerId      Int
  totalAmount     Decimal              @db.Decimal(12, 2)
  depositAmount   Decimal              @default(0) @db.Decimal(12, 2)
  financedAmount  Decimal              @db.Decimal(12, 2)
  periodMonths    Int
  ratioMultiplier Decimal              @db.Decimal(5, 4)
  totalWithRatio  Decimal              @db.Decimal(12, 2)
  monthlyAmount   Decimal              @db.Decimal(12, 2)
  startDate       DateTime             @db.Date
  endDate         DateTime             @db.Date
  status          String               @default("ACTIVE") @db.VarChar(20) // ACTIVE, COMPLETED, DEFAULTED, CANCELLED
  createdBy       Int
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  order           Order                @relation(fields: [orderId], references: [id])
  customer        Customer             @relation(fields: [customerId], references: [id])
  createdByUser   User                 @relation("PlanCreatedBy", fields: [createdBy], references: [id])
  schedule        InstallmentSchedule[]

  @@index([customerId])
  @@index([status])
  @@map("installment_plans")
}

model InstallmentSchedule {
  id              Int                 @id @default(autoincrement())
  planId          Int
  sequenceNumber  Int
  dueDate         DateTime            @db.Date
  totalAmount     Decimal             @db.Decimal(12, 2)
  principalAmount Decimal             @db.Decimal(12, 2)
  extraAmount     Decimal             @db.Decimal(12, 2)
  paidAmount      Decimal             @default(0) @db.Decimal(12, 2)
  status          String              @default("PENDING") @db.VarChar(20) // PENDING, PARTIAL, PAID, OVERDUE
  paidDate        DateTime?           @db.Date
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  plan            InstallmentPlan     @relation(fields: [planId], references: [id], onDelete: Cascade)
  allocations     PaymentAllocation[]

  @@unique([planId, sequenceNumber])
  @@index([planId])
  @@index([dueDate])
  @@index([status])
  @@index([status, dueDate])
  @@map("installment_schedule")
}

// ============================================================================
// PAYMENTS & ALLOCATIONS
// ============================================================================

model Payment {
  id                 Int                 @id @default(autoincrement())
  paymentNumber      String              @unique @db.VarChar(50)
  customerId         Int
  orderId            Int
  amount             Decimal             @db.Decimal(12, 2)
  paymentMethod      String              @db.VarChar(20) // CASH, CARD, BANK_TRANSFER, CHECK
  paymentDate        DateTime            @default(now()) @db.Date
  isReversal         Boolean             @default(false)
  reversedPaymentId  Int?
  reversalReason     String?             @db.Text
  collectedBy        Int
  createdAt          DateTime            @default(now())
  customer           Customer            @relation(fields: [customerId], references: [id])
  order              Order               @relation(fields: [orderId], references: [id])
  collectedByUser    User                @relation("PaymentCollectedBy", fields: [collectedBy], references: [id])
  reversedPayment    Payment?            @relation("PaymentReversal", fields: [reversedPaymentId], references: [id])
  reversals          Payment[]           @relation("PaymentReversal")
  allocations        PaymentAllocation[]

  @@index([customerId])
  @@index([orderId])
  @@index([paymentDate])
  @@index([createdAt])
  @@map("payments")
}

model PaymentAllocation {
  id             Int                 @id @default(autoincrement())
  paymentId      Int
  scheduleId     Int
  allocationType String              @db.VarChar(20) // PRINCIPAL, EXTRA, PREPAYMENT
  amount         Decimal             @db.Decimal(12, 2)
  createdAt      DateTime            @default(now())
  payment        Payment             @relation(fields: [paymentId], references: [id])
  schedule       InstallmentSchedule @relation(fields: [scheduleId], references: [id])

  @@index([paymentId])
  @@index([scheduleId])
  @@map("payment_allocations")
}

// ============================================================================
// AUDIT LOG
// ============================================================================

model EventLog {
  id         BigInt   @id @default(autoincrement())
  eventType  String   @db.VarChar(50)
  entityType String   @db.VarChar(50)
  entityId   Int
  userId     Int
  eventData  Json?    @db.JsonB
  ipAddress  String?  @db.Inet
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id])

  @@index([entityType, entityId])
  @@index([userId])
  @@index([createdAt])
  @@index([eventType])
  @@index([eventType, createdAt])
  @@map("event_log")
}
