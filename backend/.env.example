# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# Session pooler - supports PREPARE statements (use for Prisma operations)
# Get from: Supabase Dashboard → Settings → Database → Connection Pooling → Session mode
DATABASE_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-X-REGION.pooler.supabase.com:5432/postgres"

# Transaction pooler - for serverless/brief operations (optional, not used by Prisma)
# Get from: Supabase Dashboard → Settings → Database → Connection Pooling → Transaction mode
TRANSACTION_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-X-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================

# Port number for the Express server
PORT=4000

# Environment mode (development, production, test)
NODE_ENV=development

# =============================================================================
# JWT AUTHENTICATION CONFIGURATION
# =============================================================================

# Secret key for signing JWT tokens (REQUIRED)
# IMPORTANT: Generate a strong 256-bit random secret for production
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Example: b0b480897cea00b55e9a6fb2f6cc72eff5e5d65b1763da3032d41ec1916fe159
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# JWT token expiration time (default: 8 hours)
# Format: number + unit (s=seconds, m=minutes, h=hours, d=days)
# Examples: 30m, 8h, 7d
JWT_EXPIRATION=8h

# =============================================================================
# CORS CONFIGURATION
# =============================================================================

# Frontend application URL for CORS policy
# Development: http://localhost:5173
# Production: https://your-production-domain.com
FRONTEND_URL=http://localhost:5173
